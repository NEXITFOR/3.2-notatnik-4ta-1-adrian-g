<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:notatnik"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="notatnik.MainWindow"
        Title="Notatnik"
        Width="800" Height="600"
        MinWidth="500" MinHeight="400">

    <Grid Margin="20" RowDefinitions="Auto,Auto,*,Auto">

        <!-- Tytuł notatki -->
        <TextBox x:Name="TitleBox"
                 Grid.Row="0"
                 PlaceholderText="Tytuł notatki..."
                 Margin="0,0,0,10"
                 FontSize="16"/>

        <!-- Treść notatki -->
        <TextBox x:Name="ContentBox"
                 Grid.Row="1"
                 PlaceholderText="Treść notatki..."
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 Height="150"
                 Margin="0,0,0,10"
                 FontSize="14"/>

        <!-- Lista zapisanych notatek -->
        <Border Grid.Row="2"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="4"
                Margin="0,0,0,10"
                Padding="5">
            <ScrollViewer>
                <ItemsControl x:Name="NotesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:Note">
                            <Border BorderBrush="LightGray"
                                    BorderThickness="0,0,0,1"
                                    Padding="8"
                                    Margin="0,0,0,4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="Bold"
                                                   FontSize="14"/>
                                        <TextBlock Text="{Binding Content}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="2"
                                                   Foreground="Gray"
                                                   FontSize="12"
                                                   Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding CreatedAt}"
                                                   FontSize="10"
                                                   Foreground="DarkGray"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Usuń"
                                            VerticalAlignment="Center"
                                            Click="DeleteNote_Click"
                                            Tag="{Binding Id}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Przycisk zapisu -->
        <Button x:Name="SaveButton"
                Grid.Row="3"
                Content="Zapisz notatkę"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                FontSize="16"
                Padding="10"
                Click="SaveNote_Click"/>

    </Grid>

</Window>
